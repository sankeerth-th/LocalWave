#!/usr/bin/env sh
set -eu

APP_HOME="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GRADLE_VERSION="8.13"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-"$HOME/.gradle"}"
DIST_ROOT="$GRADLE_USER_HOME/codex-localwave-gradle"
DIST_ZIP="$DIST_ROOT/gradle-$GRADLE_VERSION-bin.zip"
DIST_DIR="$DIST_ROOT/gradle-$GRADLE_VERSION"

if [ ! -x "$DIST_DIR/bin/gradle" ]; then
  mkdir -p "$DIST_ROOT"
  if [ ! -f "$DIST_ZIP" ]; then
    curl -fsSL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$DIST_ZIP"
  fi
  unzip -q "$DIST_ZIP" -d "$DIST_ROOT"
fi

exec "$DIST_DIR/bin/gradle" -p "$APP_HOME" "$@"
